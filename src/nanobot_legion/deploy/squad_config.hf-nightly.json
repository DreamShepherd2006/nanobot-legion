{
  "_comment": "Squad non-sensitive config for HF Nightly (DreamShepherd2006/nanobot-multi-agent-nightly)",
  "deploy_platform": "hf-direct",
  "data_root": "/data",
  "webui_agent": "neo",
  "commander_whitelist": ["Stone2006", "DreamShepherd2006"],
  "user_agent_map": {
    "DreamShepherd": "NANOBOT_PEER_MEDIC",
    "Stone2006": "NANOBOT_PEER_NEO"
  },
  "relay_timeout": 120,
  "gatekeeper_port": 7860,
  "dlq_dir": "/data/dlq",
  "peers": {
    "neo": {"id": "squad:commander", "gateway_port": 20001, "ws_port": 20002}
  },
  "resurrection_whitelist": ["neo"]
}
